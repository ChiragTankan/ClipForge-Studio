rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all Default-Deny Security rule to prevent unexpected leaks
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Shared Clips Rules
    match /shared_clips/{clipId} {
      // Custom shortlink shares must be publicly readable by anyone accessing the link
      allow read, list: if true;
      
      // Creating is restricted to logged-in users
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      
      // Updates and deletions are allowed only by the original creator
      allow update, delete: if isSignedIn() && resource.data.userUid == request.auth.uid;
    }
  }
}
